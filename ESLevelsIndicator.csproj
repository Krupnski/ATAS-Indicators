<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>ESLevelsIndicator</AssemblyName>
    <RootNamespace>ATAS.Indicators.Custom</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to ATAS.Indicators.dll should be added by users from their ATAS installation -->
    <!-- Uncomment and update path when building:
    <Reference Include="ATAS.Indicators">
      <HintPath>C:\Program Files\ATAS\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    -->
  </ItemGroup>

</Project>
